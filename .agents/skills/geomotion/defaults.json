{
  "version": 18,
  "design_width": 720,
  "export": {
    "preview": {
      "width": 360,
      "height": 640,
      "fps": 24,
      "crf": 28,
      "preset": "fast",
      "maxrate": "650k",
      "bufsize": "1300k",
      "audio_bitrate": "80k"
    },
    "final": {
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "crf": 26,
      "preset": "fast",
      "maxrate": "3200k",
      "bufsize": "6400k",
      "audio_bitrate": "128k"
    },
    "final_requires_request": true,
    "create_master": false,
    "final_from_native_sources": true
  },
  "typography": {
    "regular_font": "fonts/OpenSans-Regular.ttf",
    "bold_font": "fonts/OpenSans-Bold.ttf",
    "display_font": "fonts/Montserrat-ExtraBold.ttf",
    "cta_italic_optional": true
  },
  "palette": {
    "text": "#FFFFFF",
    "cta": "#FFF4DD",
    "outline": "#4BDEEF",
    "focus": "#F3C873",
    "text_shadow": "#081219"
  },
  "composition": {
    "map_first": true,
    "subtitle_safe_area_normalized": [
      0.07,
      0.68,
      0.93,
      0.77
    ],
    "cta_area_normalized": [
      0.1,
      0.43,
      0.85,
      0.65
    ],
    "cta_max_lines": 2,
    "avoid_permanent_hud": true,
    "visual_style": "map_documentary",
    "text_policy": {
      "explanation": "voiceover_and_phrase_subtitles",
      "overlays": "brief_labels_key_figures_evidence_captions_and_optional_cta",
      "paragraphs": false,
      "bullet_slides": false,
      "duplicate_narration_as_cards": false,
      "persistent_headlines": false,
      "cards_optional": true
    },
    "layout": {
      "margin_design": 20,
      "gap_design": 12,
      "fallback_focus_normalized": [
        0.2,
        0.34,
        0.8,
        0.65
      ],
      "max_move_design_per_second": 600,
      "max_annotation_area_fraction": 0.3,
      "max_callouts": 2,
      "max_media": 1,
      "max_markers": 6,
      "max_routes": 6,
      "max_titles": 1,
      "placement_stability_weight": 0.25
    },
    "cta_font_size_design": 64
  },
  "subtitles": {
    "enabled_with_narration": true,
    "font": "fonts/OpenSans-Bold.ttf",
    "font_size_design": 44,
    "max_lines": 2,
    "target_words_per_cue": [
      3,
      5
    ],
    "stroke_design": 4,
    "phrase_sync": true,
    "karaoke": false,
    "horizontal_alignment": "center",
    "anchor_normalized": [
      0.5,
      0.77
    ],
    "preserve_authored_punctuation": true,
    "capitalize_after_sentence_end": true,
    "punctuation_by_sentence_meaning": true
  },
  "audio": {
    "voice_integrated_lufs": -13,
    "final_true_peak_dbtp": -1.5,
    "music_below_voice_db": [
      20,
      26
    ],
    "duck_attack_ms": 20,
    "duck_release_ms": 250,
    "tts": {
      "provider": "google_gemini",
      "model": "gemini-2.5-flash-preview-tts",
      "model_locked": true,
      "api_key_env": "GEMINI_API_KEY",
      "allowed_host": "generativelanguage.googleapis.com",
      "language": "id-ID",
      "model_fallback": false,
      "provider_fallback": false,
      "billing_policy": "free_quota_only_unless_user_explicitly_authorizes_paid",
      "auto_enable_billing": false,
      "cache_approved_audio": true,
      "voice_policy": "project_approved_voice_first_otherwise_use_default_Charon",
      "log_model_and_voice": true,
      "on_quota_exhausted": "report_limit_and_retry_after_without_switching_model",
      "voice_name": "Charon",
      "voice_fallback": false,
      "delivery_style": "Bahasa Indonesia natural seperti sedang menjelaskan kepada teman. Fast-paced, percaya diri, artikulasi jelas, dengan tempo cepat yang tetap nyaman diikuti. Gunakan jeda singkat dan alami sesuai tanda baca serta penekanan pada kata penting. Pertahankan variasi intonasi; hindari gaya pembaca berita, dramatisasi berlebihan, atau pengucapan terburu-buru. Baca persis narasi yang diberikan. Sesuaikan emosi dengan topik; sarkasme bukan default semua narasi.",
      "initial_voice_sample_seconds": [
        8,
        12
      ]
    }
  },
  "camera": {
    "follow_spoken_location": true,
    "gentle_continuous_motion": true,
    "ending": "widen_to_relevant_geographic_context",
    "preserve_part_continuity": true
  },
  "delivery": {
    "provider": "sites",
    "publish_after_verified_render": true,
    "format": "direct_mp4",
    "reuse_player": false,
    "editing_qualities": [
      360
    ],
    "final_qualities": [
      360,
      1080
    ],
    "default_preview_quality": 360,
    "default_final_quality": 1080,
    "download_buttons": 1,
    "download_follows_selection": true,
    "show_master": false,
    "site_binding": "delivery-target.json",
    "prepare_script": "scripts/prepare_delivery.py"
  },
  "pacing": {
    "mode": "fast-paced",
    "target_words_per_minute": [
      165,
      185
    ],
    "opening_hook_seconds": [
      0,
      2
    ],
    "meaningful_visual_beat_seconds": [
      2,
      4
    ],
    "timing_ranges_are_editorial_guides": true,
    "follow_actual_vo_phrases": true,
    "preserve_readability_and_geographic_context": true,
    "trim_unintentional_dead_air": true,
    "preserve_meaningful_pauses": true,
    "automatic_audio_speedup": false,
    "retention_improvement_guaranteed": false
  },
  "basemap": {
    "type": "satellite",
    "provider": "esri_world_imagery",
    "saturation": 1.0,
    "brightness": 1.0,
    "provider_locked": true,
    "provider_fallback": false,
    "attribution": "Esri, Vantor, Earthstar Geographics, and the GIS User Community",
    "on_failure": "report_and_stop_no_provider_substitution"
  },
  "execution": {
    "max_workers": 2,
    "final_max_workers": 1,
    "max_tile_buffer_mb": 3072,
    "checkpoint_seconds": 4,
    "memory_reserve_mb": 512,
    "estimated_worker_mb": 1536
  },
  "layout": {
    "callout_padding_design": 12,
    "callout_max_width_design": 330
  },
  "qa": {
    "loudness_tolerance_lu": 1.0,
    "duration_tolerance_frames": 1,
    "tail_warning_seconds": 0.75,
    "black_min_seconds": 0.4,
    "silence_noise_db": -40,
    "silence_min_seconds": 0.6
  },
  "region_fill": {
    "solid_opacity": 230,
    "flag_opacity": 180,
    "blend": "terrain_tint",
    "tint_exposure": 1.75,
    "tint_gamma": 1.2,
    "tint_floor": 0.15,
    "palette": {
      "red": [
        255,
        24,
        40
      ],
      "blue": [
        0,
        64,
        255
      ],
      "green": [
        24,
        255,
        64
      ],
      "yellow": [
        255,
        194,
        0
      ]
    },
    "glow": {
      "enabled": true,
      "strength": 1,
      "inside_gain": 0.025,
      "flag_strength": 0.35,
      "layers": [
        {
          "radius_design": 4,
          "gain": 0.09
        },
        {
          "radius_design": 12,
          "gain": 0.03
        }
      ]
    }
  },
  "region_outline": {
    "color": [
      245,
      248,
      246
    ],
    "reveal": 0,
    "stroke_width_design": 1.3333333333333333,
    "casing_width_design": 1.3333333333333333,
    "casing_opacity": 0,
    "casing_color": [
      7,
      12,
      18
    ],
    "glow_radius_design": 1.3333333333333333,
    "glow_opacity": 65,
    "antialias_scale": 2,
    "focus_preset": {
      "color": [
        255,
        46,
        66
      ],
      "stroke_width_design": 1.3333333333333333,
      "casing_opacity": 0
    },
    "focus_color_alternatives": [
      [
        255,
        194,
        0
      ],
      [
        0,
        195,
        255
      ]
    ],
    "glow": {
      "enabled": true,
      "layers": [
        {
          "radius_design": 1.3333333333333333,
          "gain": 0.2
        },
        {
          "radius_design": 4,
          "gain": 0.14
        },
        {
          "radius_design": 10.666666666666666,
          "gain": 0.06
        }
      ]
    }
  }
}
